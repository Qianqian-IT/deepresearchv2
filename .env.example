# =============================================================================
# DeepResearch Enterprise —— 配置样例
#
# 复制为 .env 后按需修改（.env 已在 .gitignore 中忽略，切勿提交真实密钥）。
# 生产环境请用 K8s Secret / 云密钥管理注入，不要落地明文。
#
# 生成 BYOK 加密密钥（Fernet，44 位 base64）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生成 JWT 密钥：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# ---- 基础 ----
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ---- 数据层 ----
DATABASE_URL=postgresql+asyncpg://dr:dr@localhost:5432/deepresearch
DB_ECHO=false

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- 认证与加密（生产必须覆盖！）----
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRE_MINUTES=720
BYOK_ENCRYPTION_KEY=

# ---- 配额与限流 ----
MAX_CONCURRENT_TASKS_PER_TENANT=3
MAX_TASKS_PER_DAY_PER_TENANT=200
RATE_LIMIT_PER_MINUTE=120

# ---- 产物存储（db = 存数据库；s3 = 存 MinIO/S3）----
STORAGE_BACKEND=db
S3_ENDPOINT_URL=
S3_BUCKET=deepresearch
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---- 调研执行默认值（可被租户 BYOK 覆盖）----
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=
# 内网网关场景填企业网关地址，例如 http://llm-gateway.intranet/v1
DEFAULT_LLM_BASE_URL=
RESEARCH_TASK_TIMEOUT_SECONDS=1800
RESEARCH_SOFT_TIMEOUT_SECONDS=1500
SSE_HEARTBEAT_SECONDS=15
